# Copy to .env. Never commit real keys.
# Ollama Cloud (OpenAI-compatible endpoint). Create a key at https://ollama.com/settings/keys
OLLAMA_API_KEY=
LLM_BASE_URL=https://ollama.com/v1
TARGET_MODEL=nemotron-3-nano:30b   # weak-ish on purpose: leaks prompts, follows injected instructions
SIMULATOR_MODEL=gemma4:31b          # writes the attacks; safety-tuned models (gpt-oss) refuse this job
JUDGE_MODEL=gpt-oss:20b            # PR gate; use gpt-oss:120b for nightly
REDTEAM_CACHE=1                    # 0 = bypass response cache
